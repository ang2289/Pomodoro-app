{
  "manifest_version": 3,
  "name": "RxV Publisher Helper",
  "version": "39.10.0",
  "description": "RxV Publisher V39.10：TikTok 自動選片改用本機 MP4 Blob/DataTransfer 橋接，不再對 TikTok 使用 CDP DOM.setFileInputFiles；保留出錯後手動選片續填說明。",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:3006/*",
    "http://127.0.0.1:3006/*",
    "https://www.facebook.com/*",
    "https://www.tiktok.com/*",
    "http://localhost:3005/*",
    "http://127.0.0.1:3005/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RxV Publisher Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3005/*",
        "http://127.0.0.1:3005/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*"
      ],
      "js": [
        "content-wake.js"
      ],
      "run_at": "document_idle"
    }
  ]
}