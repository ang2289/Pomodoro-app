{
  "manifest_version": 3,
  "name": "RxV Publisher Helper",
  "version": "39.12.0",
  "description": "RxV Publisher V39.12：Pinterest 直接整合 3018，一鍵自動填入圖片、標題、說明、連結與圖版，最後發布人工確認。",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:3006/*",
    "http://127.0.0.1:3006/*",
    "https://www.facebook.com/*",
    "https://www.tiktok.com/*",
    "https://www.pinterest.com/*",
    "http://localhost:3005/*",
    "http://127.0.0.1:3005/*",
    "http://localhost:3018/*",
    "http://127.0.0.1:3018/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RxV Publisher Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3005/*",
        "http://127.0.0.1:3005/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*",
        "https://www.pinterest.com/*",
        "http://localhost:3018/*",
        "http://127.0.0.1:3018/*"
      ],
      "js": [
        "content-wake.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
