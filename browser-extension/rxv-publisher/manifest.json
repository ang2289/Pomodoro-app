{
  "manifest_version": 3,
  "name": "RxV Publisher Helper",
  "version": "39.23.0",
  "description": "RxV Publisher V39.23：Pinterest 強制單一新鮮分頁、舊工作立即失效、避免帶入上一張圖片；保留圖版相似匹配與文字自動填入。",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:3006/*",
    "http://127.0.0.1:3006/*",
    "https://www.facebook.com/*",
    "https://www.tiktok.com/*",
    "https://www.pinterest.com/*",
    "http://localhost:3005/*",
    "http://127.0.0.1:3005/*",
    "http://localhost:3018/*",
    "http://127.0.0.1:3018/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RxV Publisher Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3005/*",
        "http://127.0.0.1:3005/*",
        "http://localhost:3018/*",
        "http://127.0.0.1:3018/*"
      ],
      "js": [
        "content-wake.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
