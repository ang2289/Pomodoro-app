{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/shop/:slug",
      "destination": "/api/storefront-share?slug=:slug"
    },
    {
      "source": "/goods-share/(.*)",
      "destination": "/goods-share/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/main?action=ping",
      "schedule": "0 22 * * 0"
    }
  ]
}
