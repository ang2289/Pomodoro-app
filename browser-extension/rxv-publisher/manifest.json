{
  "manifest_version": 3,
  "name": "RxV Publisher Helper",
  "version": "39.19.0",
  "description": "RxV Publisher V39.19：Pinterest 單一分頁穩定版；避免一鍵開兩頁，圖片上傳前自動建立安全尺寸副本，並保留欄位與 AI 標示自動化。",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:3006/*",
    "http://127.0.0.1:3006/*",
    "https://www.facebook.com/*",
    "https://www.tiktok.com/*",
    "https://www.pinterest.com/*",
    "http://localhost:3005/*",
    "http://127.0.0.1:3005/*",
    "http://localhost:3018/*",
    "http://127.0.0.1:3018/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RxV Publisher Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3005/*",
        "http://127.0.0.1:3005/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*",
        "https://www.pinterest.com/*",
        "http://localhost:3018/*",
        "http://127.0.0.1:3018/*"
      ],
      "js": [
        "content-wake.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
