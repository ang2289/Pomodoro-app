{
  "manifest_version": 3,
  "name": "RxV Publisher Helper",
  "version": "39.24.0",
  "description": "RxV Publisher V39.24：Pinterest 每次只建立一個全新建立 Pin 分頁，防止舊草稿／舊圖片復原；加入佇列互斥避免重複開頁。",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:3006/*",
    "http://127.0.0.1:3006/*",
    "https://www.facebook.com/*",
    "https://www.tiktok.com/*",
    "https://www.pinterest.com/*",
    "http://localhost:3005/*",
    "http://127.0.0.1:3005/*",
    "http://localhost:3018/*",
    "http://127.0.0.1:3018/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RxV Publisher Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3005/*",
        "http://127.0.0.1:3005/*",
        "http://localhost:3018/*",
        "http://127.0.0.1:3018/*"
      ],
      "js": [
        "content-wake.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
